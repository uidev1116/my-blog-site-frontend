# `npm run preview`(ローカルの workerd)用の実行時環境変数。
# `.dev.vars` にコピーして値を設定する(.dev.vars は git 管理外)。
# ビルド時の値は .env.local など、通常の Next.js の方法で渡す。
NEXT_PUBLIC_BASE_URL=
ACMS_API_PROTOCOL=
ACMS_API_HOSTNAME=
ACMS_API_PORT=
ACMS_API_KEY=
ACMS_API_PREVIEW_KEY=
ACMS_ASSETS_PROTOCOL=
ACMS_ASSETS_HOSTNAME=
ACMS_ASSETS_PORT=
