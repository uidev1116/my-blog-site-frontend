{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-blog-site-frontend",
  "compatibility_date": "2025-09-01",
  "assets": {
    // next build の出力(静的書き出し)
    "directory": "./out",
    // 存在しない URL は out/404.html を返す
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
